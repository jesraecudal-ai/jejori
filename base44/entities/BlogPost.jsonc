{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Blog post title"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "excerpt": {
      "type": "string",
      "description": "Short excerpt/summary"
    },
    "content": {
      "type": "string",
      "description": "Full blog post content in markdown"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Cover image URL"
    },
    "author": {
      "type": "string",
      "description": "Author name"
    },
    "operation": {
      "type": "string",
      "enum": [
        "brasil",
        "uruguai"
      ],
      "default": "brasil",
      "description": "Which operation/market this post belongs to"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ]
}