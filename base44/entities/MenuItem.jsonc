{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the dish"
    },
    "description": {
      "type": "string",
      "description": "Short description of the dish"
    },
    "price": {
      "type": "number",
      "description": "Base price (if single price)"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Variant options like '3 pcs - 19.9'"
    },
    "cooking": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cooking methods e.g. Steamed, Fried"
    },
    "flavors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Flavor options"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional add-ons"
    },
    "category": {
      "type": "string",
      "enum": [
        "dumplings",
        "spring_rolls",
        "buns_rice",
        "soups",
        "noodles",
        "chicken",
        "rice_snacks"
      ],
      "description": "Menu category"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the dish image"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "popular",
          "spicy",
          "new",
          "chefs_pick"
        ]
      },
      "description": "Tags for the menu item"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Whether the item is currently available"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Sort order within category"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_available": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}